# Set these values in Portainer's stack environment or in a server-local .env file.
# Do not commit the real .env file.
MTG_BIND_ADDRESS=192.168.50.102
MTG_PORT=8015
MTG_PROJECT_PATH=E:/repos/mtg/MTG_Collection_Enriched.csv
MTG_CACHE_PATH=E:/repos/mtg/.scryfall_cache
MTG_OUTPUT_PATH=E:/repos/mtg/outputs
MTG_CODEX_HOME_PATH=E:/repos/mtg/.codex-home
# Codex sign-in data stays in this persistent server-side directory; never commit it.
MTG_CODEX_ENABLED=true
